# Web address staff will use (must point at this server).
CRM_DOMAIN=crm.suncomotors.com.au

# Long random secret for sign-in sessions. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-64-random-characters

# Folder on the server for the backup copies (ideally a second disk or a NAS mount).
BACKUP_PATH=./backups
